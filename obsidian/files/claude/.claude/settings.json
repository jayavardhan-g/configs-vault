{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/vault-sync.sh",
            "timeout": 60,
            "statusMessage": "Pulling Obsidian vaults..."
          }
        ]
      }
    ]
  }
}
